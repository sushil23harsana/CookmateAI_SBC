# Copy to .env.aws on the AWS host. Do not commit the real file.
# Domain must point at the host. Caddy obtains HTTPS certificates automatically.
COOKMATE_DOMAIN=cookmate.example.com
PUBLIC_ORIGIN=https://cookmate.example.com

# Staging starts in mock mode. Enable live Swiggy only after readiness checks.
COOKMATE_PROVIDER=mock
COOKMATE_LLM=bedrock
AWS_REGION=ap-south-1
BEDROCK_MODEL=in.openai.gpt-5.6-luna
BEDROCK_MAX_TOKENS=4096
COOKMATE_MAX_TOOL_ITERATIONS=12
COOKMATE_REQUEST_TIMEOUT_MS=60000
COOKMATE_MAX_RETRIES=2

# Use the EC2 instance role. Do not paste AWS keys or mount your local .aws folder.
SWIGGY_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_CLIENT_ID=
SWIGGY_MCP_TOKEN=
# Keep the existing Neon database during the first migration; set its URL privately.
DATABASE_URL=
COOKMATE_PANTRY_FILE=/app/data/pantry.json
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=20
